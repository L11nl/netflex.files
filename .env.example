# Required
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN

# Admin Telegram user IDs, comma-separated
ADMIN_IDS=123456789

# Email provider settings
EMAIL_DOMAIN=5xu.vn
GENERATOR_BASE_URL=https://generator.email
REQUEST_TIMEOUT=20

# Automatic inbox checking
AUTO_CHECK_SECONDS=5
AUTO_WORKERS=6
MAX_AUTO_MESSAGES_PER_EMAIL=10

# Persistent Railway volume path
DB_PATH=/data/email_bot.sqlite3

# Optional initial forced-subscription channel.
# You can later change it from the bot with /setchannel
FORCE_SUB_CHANNEL=@your_channel
FORCE_SUB_URL=https://t.me/your_channel
